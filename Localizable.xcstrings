    "Restore your saved accounts from the backup you saved on your device. If you don't restore now, you won't be able to restore later." : {
      "comment" : "A description of the restore process.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكنك استعادة حساباتك المحفوظة من النسخة الاحتياطية على الجهاز. إذا لم تستعدها الآن، فلن تتمكن من استعادتها لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stellen Sie Ihre gespeicherten Konten aus der Sicherung auf Ihrem Gerät wieder her. Wenn Sie sie jetzt nicht wiederherstellen, ist dies später nicht mehr möglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Restaura tus cuentas desde la copia de seguridad guardada en el dispositivo. Si no la restauras ahora, no podrás hacerlo más tarde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حساب‌های ذخیره‌شده خود را از نسخه پشتیبان موجود در دستگاه بازیابی کنید. اگر اکنون بازیابی نکنید، بعداً نمی‌توانید این کار را انجام دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Restaurez vos comptes enregistrés à partir de la sauvegarde sur votre appareil. Si vous ne les restaurez pas maintenant, vous ne pourrez pas le faire plus tard."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dzosera maakaundi ako kubva mukopi yawakachengeta pamudziyo wako. Kana ukasadzorera iye zvino, hauzokwanisi kudzoreredza gare gare."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rejesha akaunti zako zilizohifadhiwa kutoka kwenye nakala ya akiba uliyohifadhi kwenye kifaa chako. Usipozirejesha sasa, hutaweza kuzirejesha baadaye."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kayıtlı hesaplarınızı aygıtınıza kaydettiğiniz yedekten geri yükleyin. Şimdi geri yüklemezseniz daha sonra geri yükleyemezsiniz."
          }
        }
      }
    },
