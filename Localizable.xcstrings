    "Store your recovery key somewhere safe like a password manager, and don't share it with anyone." : {
      "comment" : "A description of how to store the recovery key.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "احتفظ بمفتاح الاسترداد في مكان آمن، مثل مدير كلمات المرور، ولا تشاركه مع أحد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bewahren Sie Ihren Wiederherstellungsschlüssel an einem sicheren Ort auf, zum Beispiel in einem Passwortmanager, und geben Sie ihn an niemanden weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guarda tu clave de recuperación en un lugar seguro, como un gestor de contraseñas, y no la compartas con nadie."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کلید بازیابی خود را در مکانی امن، مانند یک مدیر گذرواژه، نگه دارید و آن را با کسی به اشتراک نگذارید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Conservez votre clé de récupération dans un endroit sûr, comme un gestionnaire de mots de passe, et ne la partagez avec personne."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chengetedza kiyi yako yekudzoreredza munzvimbo yakachengeteka, semuchirongwa chekuchengeta mapassword, uye usaipe mumwe munhu."
