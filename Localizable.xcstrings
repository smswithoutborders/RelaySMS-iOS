    "Back Up Now" : {
      "comment" : "A button that backs up the user's data.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "النسخ الاحتياطي الآن"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jetzt sichern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Crear copia de seguridad ahora"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اکنون پشتیبان‌گیری کنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sauvegarder maintenant"
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chengetedza ikozvino"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hifadhi nakala sasa"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Şimdi yedekle"
          }
        }
      }
