    "Save access to your accounts. It is stored securely on your device so you can send messages as yourself." : {
      "comment" : "A description of how to save access to your accounts.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "احفظ إمكانية الوصول إلى حساباتك. تُخزَّن بأمان على الجهاز حتى تتمكن من إرسال الرسائل بصفتك الشخصية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Speichern Sie den Zugriff auf Ihre Konten. Er wird sicher auf Ihrem Gerät gespeichert, damit Sie Nachrichten in Ihrem eigenen Namen senden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guarda el acceso a tus cuentas. Se almacena de forma segura en tu dispositivo para que puedas enviar mensajes en tu nombre."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "دسترسی به حساب‌های خود را ذخیره کنید. این اطلاعات به‌طور امن در دستگاه شما ذخیره می‌شوند تا بتوانید پیام‌ها را با هویت خود ارسال کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrez l’accès à vos comptes. Il est stocké en toute sécurité sur votre appareil afin que vous puissiez envoyer des messages en votre nom."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chengetedza nzira yekupinda mumaakaundi ako. Inochengetwa zvakachengeteka pamudziyo wako kuti utumire mameseji uchishandisa zita rako."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hifadhi ufikiaji wa akaunti zako. Unahifadhiwa kwa usalama kwenye kifaa chako ili uweze kutuma ujumbe kama wewe mwenyewe."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hesaplarınıza erişimi kaydedin. Kendi adınıza mesaj gönderebilmeniz için erişim bilgileriniz aygıtınızda güvenli bir şekilde saklanır."
          }
        }
      }
    },
