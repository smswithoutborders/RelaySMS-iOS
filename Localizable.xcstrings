        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برای بازیابی نسخه پشتیبان، نسخه جدیدی از RelaySMS نصب کنید. برنامه را باز کنید و روی «بازیابی نسخه پشتیبان» بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour restaurer une sauvegarde, installez une nouvelle copie de RelaySMS. Ouvrez l’app, puis touchez « Restaurer la sauvegarde »."
