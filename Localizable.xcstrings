    "You do not have any platformed saved. Go to platforms to save one, or use the no account option below." : {
      "comment" : "A description of the empty state when the user has no platforms.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم تحفظ أي منصة بعد. انتقل إلى المنصات لحفظ منصة أو استخدم خيار الإرسال بدون حساب أدناه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sie haben noch keine Plattform gespeichert. Gehen Sie zu den Plattformen, um eine zu speichern, oder nutzen Sie unten die Option ohne Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No has guardado ninguna plataforma. Ve a Plataformas para guardar una o usa la opción sin cuenta de abajo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنوز هیچ پلتفرمی ذخیره نکرده‌اید. برای ذخیره یک پلتفرم به بخش پلتفرم‌ها بروید یا از گزینه بدون حساب در زیر استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
