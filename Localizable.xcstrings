    "Select a platform to save it for offline use" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد منصة لحفظها للاستخدام دون اتصال بالإنترنت"
