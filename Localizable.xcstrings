    "This action cannot be undone, but you can create new backups later." : {
      "comment" : "The body of a confirmation alert that appears when the user deletes a backup.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن التراجع عن هذا الإجراء، ولكن يمكنك إنشاء نسخ احتياطية جديدة لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese Aktion kann nicht rückgängig gemacht werden, aber Sie können später neue Sicherungen erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta acción no se puede deshacer, pero puedes crear nuevas copias de seguridad más adelante."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این اقدام قابل بازگشت نیست، اما می‌توانید بعداً نسخه‌های پشتیبان جدیدی ایجاد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cette action est irréversible, mais vous pourrez créer de nouvelles sauvegardes ultérieurement."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiito ichi hachigoni kudzoserwa shure, asi unogona kugadzira makopi matsva akachengetwa gare gare."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitendo hiki hakiwezi kutenduliwa, lakini unaweza kuunda nakala mpya za akiba baadaye."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu işlem geri alınamaz ancak daha sonra yeni yedekler oluşturabilirsiniz."
          }
        }
      }
    },
    "This key is required to recover your account and data. Store this key somewhere safe. If you lose it, you won't be able to recover your account." : {
      "comment" : "The text that describes the importance of keeping the recovery key safe.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هذا المفتاح مطلوب لاسترداد حسابك وبياناتك. يرجى حفظه في مكان آمن. إذا فقدته، فلن تتمكن من استرداد حسابك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Schlüssel wird benötigt, um Ihr Konto und Ihre Daten wiederherzustellen. Bewahren Sie ihn an einem sicheren Ort auf. Wenn Sie ihn verlieren, können Sie Ihr Konto nicht wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta clave es necesaria para recuperar tu cuenta y tus datos. Guárdala en un lugar seguro. Si la pierdes, no podrás recuperar tu cuenta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این کلید برای بازیابی حساب و داده‌های شما لازم است. آن را در مکانی امن نگه دارید. اگر آن را گم کنید، نمی‌توانید حساب خود را بازیابی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cette clé est nécessaire pour récupérer votre compte et vos données. Conservez-la en lieu sûr. Si vous la perdez, vous ne pourrez pas récupérer votre compte."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiyi iyi inodiwa kuti udzorere akaundi yako nedata rako. Ichengete munzvimbo yakachengeteka. Kana ukairasa, hauzokwanisi kudzoreredza akaundi yako."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ufunguo huu unahitajika ili kurejesha akaunti na data yako. Hifadhi ufunguo huu mahali salama. Ukiupoteza, hutaweza kurejesha akaunti yako."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu anahtar hesabınızı ve verilerinizi kurtarmak için gereklidir. Anahtarı güvenli bir yerde saklayın. Kaybederseniz hesabınızı kurtaramazsınız."
          }
        }
      }
    },
    "To restore a backup, install a new copy of RelaySMS. Open the app, tap \"Restore backup\"." : {
      "comment" : "A description of how to restore a backup.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لاستعادة نسخة احتياطية، يرجى تثبيت نسخة جديدة من RelaySMS. افتح التطبيق واضغط على \"استعادة النسخة الاحتياطية\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um eine Sicherung wiederherzustellen, installieren Sie RelaySMS erneut. Öffnen Sie die App und tippen Sie auf „Sicherung wiederherstellen“."
